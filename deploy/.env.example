# Copy to /opt/pagemint/.env on the server and fill in. Never commit the real file.
COMPOSE_PROFILES=full
# Your server's address: the public IP with dashes + .sslip.io, e.g. 140-238-1-2.sslip.io
PAGEMINT_HOST=CHANGE-ME.sslip.io
PAGEMINT_PUBLIC_URL=https://CHANGE-ME.sslip.io
# From your GitHub OAuth App (Settings -> Developer settings -> OAuth Apps)
PAGEMINT_GITHUB_CLIENT_ID=CHANGE-ME
PAGEMINT_GITHUB_CLIENT_SECRET=CHANGE-ME
# Random values (cloud-init fills these in for you)
PAGEMINT_SECRET_KEY=CHANGE-ME-64-random-characters
SEARXNG_SECRET=CHANGE-ME-random
# Who may sign in: GitHub usernames separated by commas, or * for everyone
PAGEMINT_ALLOWED_USERS=HarshaVardhan1111
PAGEMINT_MIN_GITHUB_ACCOUNT_DAYS=30
# Optional: Oracle Object Storage pre-authenticated request URL (bucket, read/write) for nightly backups
PAGEMINT_BACKUP_PAR_URL=
